# Pronunciation checker (zipa server, reached through a Tailscale Funnel
# address). Server-side only: read by the /api/pronounce/* routes, which add
# the key and forward requests. Never prefix these with NEXT_PUBLIC_, or they
# would be bundled into the browser. Ask the team for the values; never commit them.
PRONOUNCE_API_URL=
PRONOUNCE_API_KEY=

# Server-side credentials for AMPLIFY's existing Supabase Auth project.
# Keep these server-only; no service-role key is needed by ATLAS.
AMPLIFY_SUPABASE_URL=https://your-project.supabase.co
AMPLIFY_SUPABASE_ANON_KEY=your-supabase-anon-key
