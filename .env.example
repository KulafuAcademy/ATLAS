# Base URL of the wav2vec2 pronunciation assessment server (no trailing slash).
# Free ngrok URLs change on restart; update this when they do.
NEXT_PUBLIC_PRONUNCIATION_API_URL=https://oil-sterility-cyclic.ngrok-free.dev

# Optional. Only if the server requires an API key (sent as X-API-Key).
# NEXT_PUBLIC_ values are bundled into the browser and visible to anyone.
# NEXT_PUBLIC_PRONUNCIATION_API_KEY=

# Server-side credentials for AMPLIFY's existing Supabase Auth project.
# Keep these server-only; no service-role key is needed by ATLAS.
AMPLIFY_SUPABASE_URL=https://your-project.supabase.co
AMPLIFY_SUPABASE_ANON_KEY=your-supabase-anon-key
